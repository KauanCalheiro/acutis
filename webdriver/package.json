{
  "name": "acutis-webdriver",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import @swc-node/register/esm-register src/main.ts",
    "build": "tsc",
    "build:ui": "vite build --config vite.ui.config.ts",
    "start": "node dist/main.js",
    "test": "vitest run --config vite.ui.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "vue-tsc --noEmit -p tsconfig.ui.json"
  },
  "dependencies": {
    "@medv/finder": "^3.1.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-ws": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.61.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "vue": "^3.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.30",
    "@types/express": "^4.17.25",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.0.0"
  }
}
