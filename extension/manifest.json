{
  "manifest_version": 3,
  "name": "Acutis Recorder",
  "version": "1.0.0",
  "description": "Grava interações do navegador e transmite ao Acutis.",
  "permissions": ["tabs", "windows", "scripting", "storage", "activeTab", "alarms"],
  "host_permissions": ["<all_urls>"],
  "incognito": "spanning",
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/recorder/index.ts"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Acutis Recorder",
    "default_icon": {
      "16": "public/assets/icon16.png",
      "32": "public/assets/icon32.png",
      "48": "public/assets/icon48.png",
      "128": "public/assets/icon128.png"
    }
  },
  "icons": {
    "16": "public/assets/icon16.png",
    "32": "public/assets/icon32.png",
    "48": "public/assets/icon48.png",
    "128": "public/assets/icon128.png"
  }
}
