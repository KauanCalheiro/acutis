{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git commit*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-guard/index.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking the commit standard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-write/index.mjs\"",
            "timeout": 180,
            "statusMessage": "Lint, teste relacionado e travessão"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/finish-check/index.mjs\"",
            "timeout": 300,
            "statusMessage": "Typecheck, cobertura e duplicação"
          }
        ]
      }
    ]
  }
}
