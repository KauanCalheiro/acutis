{
  "name": "acutis",
  "version": "1.0.0",
  "description": "Grava, gera e roda testes Playwright a partir do navegador",
  "private": true,
  "license": "MIT",
  "bin": {
    "acutis": "bin/acutis.js"
  },
  "files": [
    ".output",
    "bin",
    "dist-ui",
    "reporters/stream-reporter.cjs",
    "stubs"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm build:recorder && nuxt build",
    "build:recorder": "vite build --config vite.recorder.config.ts",
    "cli:build": "pnpm build",
    "dev": "node bin/ensure-chromium.js && pnpm build:recorder && nuxt dev",
    "lint": "eslint .",
    "postinstall": "nuxt prepare",
    "prepack": "pnpm build",
    "preview": "node bin/ensure-chromium.js && nuxt preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @acutis/e2e test",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/lucide": "^1.2.114",
    "@iconify-json/simple-icons": "^1.2.87",
    "@langchain/anthropic": "^1.5.5",
    "@langchain/core": "^1.2.7",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.7",
    "@langchain/openrouter": "^0.4.7",
    "@medv/finder": "^3.1.0",
    "@nuxt/ui": "^4.9.0",
    "@openai/codex-sdk": "^0.147.0",
    "better-sqlite3": "^13.0.3",
    "langchain": "^1.5.8",
    "nuxt": "^4.4.8",
    "playwright": "^1.61.1",
    "prismjs": "^1.30.0",
    "simple-git": "^3.36.0",
    "tailwindcss": "^4.3.1",
    "typeorm": "^1.1.0",
    "vue": "^3.5.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.0",
    "@types/prismjs": "^1.26.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.6.0",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  },
  "packageManager": "pnpm@11.9.0"
}
