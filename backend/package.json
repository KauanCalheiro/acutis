    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "typescript": "^5.4.0",
    "unplugin-swc": "^1.5.11",
