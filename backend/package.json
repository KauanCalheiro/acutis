{
  "name": "acutis-cli",
  "version": "1.0.0",
  "description": "Grava, gera e roda testes Playwright a partir do navegador",
  "//private": "Tire esta linha para poder publicar. Ela é o pino de segurança: enquanto estiver aqui, `npm publish` recusa — e `npm pack` continua funcionando para testar local.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KauanCalheiro/acutis.git",
    "directory": "backend"
  },
  "homepage": "https://github.com/KauanCalheiro/acutis#readme",
  "keywords": [
    "playwright",
    "e2e",
    "test-recorder",
    "gherkin"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "acutis": "bin/acutis.js"
  },
  "files": [
    "bin",
    "dist",
    "dist-ui",
    "frontend",
    "reporters/stream-reporter.cjs",
    "stubs"
  ],
  "scripts": {
    "dev": "node --import @swc-node/register/esm-register src/main.ts",
    "db:fresh": "node --import @swc-node/register/esm-register src/scripts/db-fresh.ts",
    "build": "tsc",
    "build:ui": "vite build --config vite.ui.config.ts",
    "cli:build": "pnpm build:ui && pnpm build && node scripts/bundle-frontend.js",
    "prepack": "pnpm --dir ../frontend build && pnpm cli:build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "vue-tsc --noEmit -p tsconfig.ui.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "@langchain/anthropic": "^1.5.5",
    "@langchain/core": "^1.2.7",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.7",
    "@langchain/openrouter": "^0.4.7",
    "@medv/finder": "^3.1.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-ws": "^10.4.15",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^10.4.15",
    "better-sqlite3": "^13.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "langchain": "^1.5.8",
    "playwright": "^1.61.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "simple-git": "^3.36.0",
    "typeorm": "^1.1.0",
    "vue": "^3.5.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^11.1.29",
    "@playwright/test": "^1.61.1",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.30",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.67.0",
    "unplugin-swc": "^1.5.11",
    "vite": "^5.2.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.0.0"
  }
}
